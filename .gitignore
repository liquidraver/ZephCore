*.log
rtt_*.txt
jlink_*.txt
*.jlink
*.dmp
core
*.tmp
*.orig

# ---- Binaries -----------------------------------------------------------------
*.uf2
*.hex
*.bin
*.elf
*.map
*.obj
*.o
*.a
*.zip
# ...except shipped artifacts: the SoftDevice formatter DFU packages (build.sh
# publishes them as the configurator's `erase` packages, formatter/README.md) and
# the prebuilt LR1110 radio-firmware updaters (LR1110_updater/README.md).
!formatter/
!formatter/*.uf2
!formatter/*.zip
!LR1110_updater/
!LR1110_updater/*.uf2
!LR1110_updater/*.bin

