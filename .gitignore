# ---- Local-only working docs --------------------------------------------------
# devdocs/ holds the restructure plan, LLDs, audit indexes, handovers, trackers.
/devdocs/
/westchanges/
/meshtimesync-sim/
CLAUDE.md
# Working docs dropped at the root by habit: matched by shape, not one by one
# (a per-file list once missed one and it went into a commit).
[Hh][Aa][Nn][Dd][Oo][Vv][Ee][Rr]_*.md
*_AUDIT_INDEX.md
*_HANDOFF.md
UPSTREAM_TRACKER.md
WEST_UPDATE.md

# Vendor reference docs (datasheets, errata): not ours to redistribute.
/datasheets/

# Release notes of versions released before the tracked set began. The notes
# file of the CURRENT version must stay tracked: the release workflow publishes
# it as the GitHub release body (body_path).
releasenotes/RELEASE_NOTES_1.16.3-zephcore.md
releasenotes/RELEASE_NOTES_1.16.4-zephcore.md

