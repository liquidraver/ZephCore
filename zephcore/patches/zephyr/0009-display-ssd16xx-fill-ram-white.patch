diff --git a/drivers/display/ssd16xx.c b/drivers/display/ssd16xx.c
index fe3dad88f45..b03338bd3c6 100644
--- a/drivers/display/ssd16xx.c
+++ b/drivers/display/ssd16xx.c
@@ -78,6 +78,7 @@ struct ssd16xx_data {
 	bool blanking_on;
 	enum ssd16xx_profile_type profile;
 	enum display_orientation orientation;
+	bool deep_sleep;
 };
 
 struct ssd16xx_dt_array {
@@ -286,10 +287,64 @@ static int ssd16xx_update_display(const struct device *dev)
 	return ssd16xx_activate(dev, update_cmd);
 }
 
+/*
+ * Leave deep sleep (ssd16xx_deep_sleep()): only a hardware reset wakes the
+ * controller, and the reset clears its registers but not its RAM, so the
+ * active profile is loaded again and partial refresh carries on.
+ */
+static int ssd16xx_wake(const struct device *dev)
+{
+	const struct ssd16xx_config *config = dev->config;
+	struct ssd16xx_data *data = dev->data;
+	enum ssd16xx_profile_type profile = data->profile;
+	int err;
+
+	if (!data->deep_sleep) {
+		return 0;
+	}
+
+	err = mipi_dbi_reset(config->mipi_dev, SSD16XX_RESET_DELAY);
+	if (err < 0) {
+		return err;
+	}
+
+	k_msleep(SSD16XX_RESET_DELAY);
+	data->deep_sleep = false;
+	data->profile = SSD16XX_PROFILE_INVALID;
+
+	return ssd16xx_set_profile(dev, profile < SSD16XX_NUM_PROFILES ?
+				   profile : SSD16XX_PROFILE_FULL);
+}
+
+int ssd16xx_deep_sleep(const struct device *dev)
+{
+	struct ssd16xx_data *data = dev->data;
+	int err;
+
+	if (data->deep_sleep) {
+		return 0;
+	}
+
+	/* Waits for a running refresh to end first. */
+	err = ssd16xx_write_uint8(dev, SSD16XX_CMD_SLEEP_MODE,
+				  SSD16XX_SLEEP_MODE_DSM);
+	if (err < 0) {
+		return err;
+	}
+
+	data->deep_sleep = true;
+
+	return 0;
+}
