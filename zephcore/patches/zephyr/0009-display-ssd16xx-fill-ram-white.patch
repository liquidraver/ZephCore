 	err = ssd16xx_set_window(dev, x, y, desc);
 	if (err < 0) {
 		return err;
@@ -605,6 +672,10 @@ static int ssd16xx_set_orientation(const struct device *dev,
 	struct ssd16xx_data *data = dev->data;
 	int err;
 
+	if (ssd16xx_wake(dev) < 0) {
