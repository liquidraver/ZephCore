+	if (bandwidth_to_hz(data->config.bandwidth, &bw_hz) < 0) {
+		bw_hz = 0;  /* unconfigured: the helper's safe default */
+	}
+	return zc_lora_max_payload_ms((uint8_t)data->config.datarate, bw_hz);
