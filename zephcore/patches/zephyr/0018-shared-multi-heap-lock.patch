shared_multi_heap: lock the pool.

sys_heap is not internally synchronized and shared_multi_heap added no lock,
although it is a system-wide pool for drivers and applications. On ESP32 with
CONFIG_ESP_WIFI_HEAP_SPIRAM (every PSRAM Wi-Fi companion) the Wi-Fi adapter
(hal_espressif esp_heap_adapter.h) allocates and frees from it on several
threads at once; under Wi-Fi traffic that corrupted the heap ("heap
corruption (free list linkage)" / "double free?") and panicked the Wi-Fi
task. A spinlock around every pool operation, as k_heap does around the same
allocator.

Found and bench-verified 2026-09-24 on a XIAO ESP32-S3 companion
(devdocs/lld/08-connectivity.md, "Wi-Fi flood wedge"). Not fixed on Zephyr
main as of 15723416fdd (2026-09-24).

diff --git a/lib/heap/shared_multi_heap.c b/lib/heap/shared_multi_heap.c
index c6a4fe50d58..6af29745d5c 100644
--- a/lib/heap/shared_multi_heap.c
+++ b/lib/heap/shared_multi_heap.c
@@ -13,6 +13,18 @@
 
 static struct sys_multi_heap shared_multi_heap;
 
+/*
+ * ZephCore: sys_heap is not internally synchronized ("All locking must be
+ * provided by the user", sys_heap.h), and neither was this pool, although it
+ * is a system-wide service shared by drivers and applications. On ESP32 with
+ * CONFIG_ESP_WIFI_HEAP_SPIRAM the Wi-Fi adapter allocates and frees from here
+ * on several threads at once (the Wi-Fi task, its event thread and every
+ * transmitting thread); under traffic that corrupted the heap ("double
+ * free?" / "free list linkage") and panicked the Wi-Fi task. A spinlock, as
+ * k_heap uses around the same allocator.
+ */
+static struct k_spinlock smh_lock;
+
 static struct {
 	struct sys_heap heap_pool[MAX_MULTI_HEAPS];
 	unsigned int heap_cnt;
@@ -66,6 +78,8 @@ int shared_multi_heap_add(struct shared_multi_heap_region *region, void *user_da
 		return -ENOMEM;
 	}
 
+	k_spinlock_key_t key = k_spin_lock(&smh_lock);
+
 	slot = smh_data[attr].heap_cnt;
 	h = &smh_data[attr].heap_pool[slot];
 
@@ -74,12 +88,17 @@ int shared_multi_heap_add(struct shared_multi_heap_region *region, void *user_da
 
 	smh_data[attr].heap_cnt++;
 
+	k_spin_unlock(&smh_lock, key);
+
 	return 0;
 }
 
 void shared_multi_heap_free(void *block)
 {
+	k_spinlock_key_t key = k_spin_lock(&smh_lock);
+
 	sys_multi_heap_free(&shared_multi_heap, block);
+	k_spin_unlock(&smh_lock, key);
 }
 
 void *shared_multi_heap_alloc(enum shared_multi_heap_attr attr, size_t bytes)
@@ -88,7 +107,11 @@ void *shared_multi_heap_alloc(enum shared_multi_heap_attr attr, size_t bytes)
 		return NULL;
 	}
 
-	return sys_multi_heap_alloc(&shared_multi_heap, (void *)(long) attr, bytes);
+	k_spinlock_key_t key = k_spin_lock(&smh_lock);
+	void *block = sys_multi_heap_alloc(&shared_multi_heap, (void *)(long) attr, bytes);
+
+	k_spin_unlock(&smh_lock, key);
+	return block;
 }
 
 void *shared_multi_heap_realloc(enum shared_multi_heap_attr attr, void *ptr, size_t bytes)
@@ -97,8 +120,12 @@ void *shared_multi_heap_realloc(enum shared_multi_heap_attr attr, void *ptr, siz
 		return NULL;
 	}
 
-	return sys_multi_heap_aligned_realloc(&shared_multi_heap, (void *)(long) attr,
-					      ptr, 0, bytes);
+	k_spinlock_key_t key = k_spin_lock(&smh_lock);
+	void *block = sys_multi_heap_aligned_realloc(&shared_multi_heap, (void *)(long) attr,
+						     ptr, 0, bytes);
+
+	k_spin_unlock(&smh_lock, key);
+	return block;
 }
 
 void *shared_multi_heap_aligned_alloc(enum shared_multi_heap_attr attr,
@@ -108,8 +135,12 @@ void *shared_multi_heap_aligned_alloc(enum shared_multi_heap_attr attr,
 		return NULL;
 	}
 
-	return sys_multi_heap_aligned_alloc(&shared_multi_heap, (void *)(long) attr,
-					    align, bytes);
+	k_spinlock_key_t key = k_spin_lock(&smh_lock);
+	void *block = sys_multi_heap_aligned_alloc(&shared_multi_heap, (void *)(long) attr,
+						   align, bytes);
+
+	k_spin_unlock(&smh_lock, key);
+	return block;
 }
 
 int shared_multi_heap_pool_init(void)
