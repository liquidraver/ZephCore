/*
 * ThinkNode M6 formatter overlay — minimal drivers.
 *
 * The M6 board DTS no longer carries the QSPI flash: no shipped unit has the
 * chip fitted, so the board dropped &qspi, its partition, the P0.21 enable
 * regulator and the qspi-ext.dtsi (/ext) include together (see the note in
 * thinknode_m6.dts).  There is therefore no /ext LittleFS instance to drop
 * and no QSPI enable to hog here; main.c's PARTITION_EXISTS() checks
 * simply skip the QSPI erase.  If the board ever restores QSPI, restore the
 * "/delete-node/ &qspi_lfs;" and the P0.21 hog that used to live here.
 *
 * Replace the regulator-fixed power-enable node with a gpio-hog so
 * CONFIG_REGULATOR is not forced on by regulator-boot-on.
 */

/* Remove regulator-fixed node and replace with a gpio-hog */
/delete-node/ &pwr_enable;

&gpio0 {
	/* Board power enable (PIN_PWR_EN = P0.27) */
	pwr-en-hog {
		gpio-hog;
		gpios = <27 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "PWR Enable";
	};
};
